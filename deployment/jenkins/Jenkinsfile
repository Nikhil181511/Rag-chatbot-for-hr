pipeline {
    agent any

    environment {
        APP_NAME = 'hr-rag'
        GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD || echo local', returnStdout: true).trim()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint & Type Check') {
            parallel {
                stage('Backend Lint') {
                    steps {
                        sh '''
                            cd backend
                            python3 -m venv .venv || true
                            . .venv/bin/activate
                            pip install ruff mypy
                            ruff check . || true
                            mypy app/ || true
                        '''
                    }
                }
                stage('Frontend Lint') {
                    steps {
                        sh '''
                            cd frontend
                            npm ci
                            npm run lint || true
                        '''
                    }
                }
            }
        }

        stage('Test') {
            steps {
                sh '''
                    chmod +x deployment/jenkins/test.sh || true
                    ./deployment/jenkins/test.sh
                '''
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Build Backend') {
                    steps {
                        sh '''
                            docker build -t ${APP_NAME}-backend:${GIT_COMMIT_SHORT} -t ${APP_NAME}-backend:latest -f backend/Dockerfile backend/
                        '''
                    }
                }
                stage('Build Frontend') {
                    steps {
                        sh '''
                            docker build -t ${APP_NAME}-frontend:${GIT_COMMIT_SHORT} -t ${APP_NAME}-frontend:latest -f frontend/Dockerfile frontend/
                        '''
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                sh '''
                    if [ -f /var/jenkins_home/.kube/config ]; then
                        sed 's|127.0.0.1|host.docker.internal|g; s|https://kubernetes.docker.internal:6443|https://host.docker.internal:6443|g' /var/jenkins_home/.kube/config > /tmp/kubeconfig
                        export KUBECONFIG=/tmp/kubeconfig
                    fi
                    kubectl apply -f deployment/kubernetes/namespace.yaml --insecure-skip-tls-verify=true
                    kubectl apply -f deployment/kubernetes/configmap.yaml --insecure-skip-tls-verify=true
                    kubectl apply -f deployment/kubernetes/postgres.yaml --insecure-skip-tls-verify=true
                    kubectl apply -f deployment/kubernetes/backend-deployment.yaml --insecure-skip-tls-verify=true
                    kubectl apply -f deployment/kubernetes/frontend-deployment.yaml --insecure-skip-tls-verify=true
                    kubectl apply -f deployment/kubernetes/ingress.yaml --insecure-skip-tls-verify=true
                    kubectl rollout status statefulset/hr-rag-postgres -n hr-rag --timeout=120s || true
                    kubectl rollout status deployment/hr-rag-backend -n hr-rag --timeout=120s || true
                    kubectl rollout status deployment/hr-rag-frontend -n hr-rag --timeout=60s || true
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "CI/CD Pipeline succeeded for commit ${GIT_COMMIT_SHORT}"
        }
        failure {
            echo "CI/CD Pipeline failed!"
        }
    }
}
